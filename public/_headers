# Security headers read by Cloudflare Pages and Netlify.
#
# The application makes no outbound request, loads no remote font, uses no
# data image and sets no inline style. The policy can start from
# `default-src 'none'` and open only resources served by this origin.
#
# The page holds encrypted credentials and thirteen agent tools. An injected
# script could reach everything the user sees, while framing could disguise an
# approval click.
#
# The build replaces `__CSP_SCRIPT_HASH__` with the hash of the single inline
# theme bootstrap script.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' '__CSP_SCRIPT_HASH__'; style-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Fingerprinted assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These files change between deployments and must be revalidated.
/index.html
  Cache-Control: no-cache, no-transform
/sw.js
  Cache-Control: no-cache, no-transform
/manifest.webmanifest
  Cache-Control: no-cache, no-transform
