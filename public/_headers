# Security headers read by Cloudflare Pages and Netlify.
#
# The application makes no outbound request of its own, uses no data image and
# sets no inline style. It does load the Material typeface and icon set from
# Google Fonts, so the policy starts from `default-src 'none'` and opens
# exactly two remote origins : the stylesheet host and the font host. Nothing
# else is reachable, and no other directive is widened.
#
# The page holds encrypted credentials and thirteen agent tools. An injected
# script could reach everything the user sees, while framing could disguise an
# approval click.
#
# The build replaces `__CSP_SCRIPT_HASH__` with the hash of the single inline
# theme bootstrap script.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' '__CSP_SCRIPT_HASH__'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()

# No `Cache-Control` on `/*`. Cloudflare's Workers assets do not let a more
# specific rule replace this one, they concatenate both, and the served header
# came out as
#   public, max-age=0, must-revalidate, no-transform, public, max-age=31536000, immutable
# which breaks twice. `no-transform` leaked onto the hashed assets and stopped
# the edge compressing them, so 186 kB of JavaScript went over the wire instead
# of 55. And the first `max-age` wins, so the year-long immutable cache was
# never applied to anything. Each path now carries its own policy, and only its
# own.

# Fingerprinted assets are immutable, and must stay compressible.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else is an application document: revalidated, and left untouched
# by the edge so the strict CSP document keeps the bytes it was signed with.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# These files change between deployments and must be revalidated.
/index.html
  Cache-Control: no-cache, no-transform
/sw.js
  Cache-Control: no-cache, no-transform
/manifest.webmanifest
  Cache-Control: no-cache, no-transform
