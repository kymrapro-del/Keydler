{
  "name": "cahier-de-quart",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Cahier de quart — mémoire de tâche persistante pour agents WebMCP",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && npm run lint && npm run format:check && npm test && vite build",
    "build:trial": "TRIAL=1 tsc --noEmit && TRIAL=1 vite build",
    "trial": "npm run build:trial && vite preview --port 5174",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.11.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "idb": "^8.0.3"
  }
}
