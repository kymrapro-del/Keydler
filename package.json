{
  "name": "cahier-de-quart",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Cahier de quart — mémoire de tâche persistante pour agents WebMCP",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && npm test && vite build",
    "build:trial": "TRIAL=1 tsc --noEmit && TRIAL=1 vite build",
    "trial": "npm run build:trial && vite preview --port 5174"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
