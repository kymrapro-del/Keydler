// Prepared fallback deployment, not the preferred setup.
//
// Cloudflare Pages serves the application at https://keydler.pages.dev. The
// preferred fix is to point keydler.com DNS at that Pages project. This Worker
// exists because the deployment token can write Worker routes but cannot read
// or update DNS records.
//
// Route patterns include the scheme so plain HTTP cannot serve a page whose
// origin trial token is valid only for HTTPS. Enable Always Use HTTPS on the
// zone as well.
//
// Remove these routes after DNS is corrected, otherwise the Worker would hide
// the Pages custom domain. This Worker contains no script and serves only
// `dist/`, including `_headers`. A separate Worker redirects www to the apex.
{
  "name": "keydler-site",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Deep links such as `/t/:id` must render the application, not a 404.
    "not_found_handling": "single-page-application",
  },
  "workers_dev": false,
  "routes": [{ "pattern": "https://keydler.com/*", "zone_name": "keydler.com" }],
}
