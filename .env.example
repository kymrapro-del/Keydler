# Jeton d'origin trial WebMCP, obtenu sur https://developer.chrome.com/origintrials
# Un jeton par origine déployée. Inutile en local : le drapeau
# chrome://flags/#enable-webmcp-testing suffit.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=

# Cloud optionnel : l'application reste entièrement locale sans ces valeurs.
# Utiliser la clé publishable/anon du projet, jamais la service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
