# Edge Function secrets. Set with `supabase secrets set`; never expose these
# values through Vite or commit a populated copy of this file.

# Exactly 32 random bytes encoded as base64, for example:
# openssl rand -base64 32
CONNECTOR_MASTER_KEY=

# Comma-separated exact production origins. Localhost and 127.0.0.1 are
# accepted automatically by the function for local development.
ALLOWED_ORIGINS=https://your-production-domain.example

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to deployed Supabase Edge Functions.
